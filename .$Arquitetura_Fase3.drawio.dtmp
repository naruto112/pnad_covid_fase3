        <mxCell id="dGfEtmnSb2TWL7WWUB0G-27" parent="dGfEtmnSb2TWL7WWUB0G-2" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=1;aspect=fixed;image=img/clipart/Gear_128x128.png;direction=east;" value="ETL&lt;div&gt;spec_to_trusted&lt;/div&gt;" vertex="1">
